*.pyc
.venv/
uv.lock
.DS_Store

# generated corpora and tokenizer artifacts
data/corpus/
data/*.bin
data/bpe*.json

# cached paraphrases are expensive to regenerate — keep them, they are the dataset
!data/cache/

# training runs
runs/

# generated headers and exported weights
firmware/generated/
firmware/model/
data/*_tok.u16
data/*_mask.u8
data/meta.json
data/v0_artifacts/

# Copies made by firmware/device/sync.sh so the Arduino build can see them.
# The originals live in firmware/common; editing these is editing a copy that
# the next sync silently overwrites.
firmware/device/espcontrol/llm.h
firmware/device/espcontrol/tokenizer.h
firmware/device/espcontrol/command.h
firmware/device/espcontrol/gpio_control.h
firmware/device/espcontrol/gpio_control.c
firmware/device/espcontrol/symbols.h
firmware/device/espcontrol/bpe.h

# release artifacts
dist/
firmware/device/espcontrol/build/

# Held-out sets, the raw model dumps they were built from, and the tooling that
# labels them. Kept locally, not published: the locked half only stays held-out
# while it is unseen, and publishing it is the one way to guarantee a future
# model has read it. The corpus generators above (frames.py, realize.py,
# negatives.py, build_corpus.py) do stay tracked -- gen_assets.py and
# c_check.py import frames, so release.sh cannot run without them.
data/eval/
data/eval_raw/
data/eval_prompts/
data/eval_human.md
data/label_eval.py
data/ingest_eval.py
data/migrate_eval.py
data/audit_corpus.py

# Working notes and drafts.
docs/
ai_studio_code.txt
